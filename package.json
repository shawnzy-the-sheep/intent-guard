{
  "name": "intentguard-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @intentguard/demo build",
    "typecheck": "tsc -b && pnpm --filter @intentguard/demo typecheck",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:start": "pnpm --filter @intentguard/demo dev",
    "intentguard": "node packages/cli/dist/index.js",
    "bench": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0",
    "playwright": "^1.56.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  }
}
